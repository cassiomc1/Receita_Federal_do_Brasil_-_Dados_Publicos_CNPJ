# Diretórios de armazenamento (ajuste conforme seu sistema operacional)
# Exemplo Linux/macOS: /dados/rfb/output_files
# Exemplo Windows: C:\Dados_RFB\output_files
OUTPUT_FILES_PATH=./dados/output_files
EXTRACTED_FILES_PATH=./dados/extracted_files

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=Dados_RFB

# Configurações opcionais da Receita Federal
# Se RFB_ANO_MES ficar em branco, o script baixa automaticamente o mês mais recente disponível
# RFB_ANO_MES=2026-08
# RFB_SHARE_TOKEN=YggdBLfdninEJX9

# Opcional: pular etapas se você já tiver os arquivos baixados ou descompactados
# PULAR_DOWNLOAD=False
# PULAR_EXTRACAO=False

# -----------------------------------------------------------------------------
# TypeSafe AI (System One / Jev) - Inteligência Artificial Estruturada
# -----------------------------------------------------------------------------
# Chave de API para busca em linguagem natural e diagnóstico cadastral com IA.
# É NECESSÁRIO adicionar sua própria chave obtida no console da TypeSafe AI:
